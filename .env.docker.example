# ─────────────────────────────────────────────────────────────────────────────
# .env.docker — Production environment for Docker deployment
# Copy this file to .env.docker on the VPS and fill in the real values.
# NEVER commit .env.docker to git.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Typing Game"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tm.itify.my

# Generate with: docker compose run --rm tmg_app php artisan key:generate --show
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Database (DB_HOST is overridden to tmg_db by docker-compose.yml) ─────────
DB_CONNECTION=mysql
DB_HOST=tmg_db
DB_PORT=3306
DB_DATABASE=typing_game
DB_USERNAME=tmg
DB_PASSWORD=change_me_strong_password

# Also set this — used by the tmg_db MySQL container root account
DB_ROOT_PASSWORD=change_me_root_password

# ── Session / Cache / Queue ───────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Mailer service (overridden to http://tmg_mailer:4001 by docker-compose) ──
MAILER_SERVICE_URL=http://tmg_mailer:4001

# ── Host port the VPS reverse proxy should point to ──────────────────────────
APP_PORT=8080
