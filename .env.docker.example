# ─────────────────────────────────────────────────────────────────────────────
# .env.docker — Production environment for Docker deployment
# Copy this file to .env on the VPS and fill in the real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Typing Game"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tm.brightstarcomp.my

# Generate with: docker compose run --rm tmg_app php artisan key:generate --show
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database (DB_HOST is overridden to tmg_db by docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=tmg_db
DB_PORT=3306
DB_DATABASE=typing_game
DB_USERNAME=tmg
DB_PASSWORD=change_me_strong_password

# Required by tmg_db MySQL container for the root account
DB_ROOT_PASSWORD=change_me_root_password

# Session / Cache / Queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# SMTP Mail (Laravel Mail — no separate mailer service needed)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.brightstarcomp.com
MAIL_PORT=465
MAIL_USERNAME=noreply@brightstarcomp.com
MAIL_PASSWORD=change_me_mail_password
MAIL_FROM_ADDRESS=noreply@brightstarcomp.com
MAIL_FROM_NAME="Typing Game | Brightstar Computer"
